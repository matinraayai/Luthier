# Verifies that the at-MBB-entry mock pass creates one injected payload per
# MBB of the target machine function. This test pins to gfx90a (CDNA2,
# wave64) — the four payload-injection tests intentionally cover four
# distinct architectures.
#

# RUN: luthier-llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a \
# RUN:    %luthier_mock_injection_plugin \
# RUN:    '-passes=luthier-mock-inject-at-mbb-entry' \
# RUN:    %s -o %t.out.luthier && \
# RUN: FileCheck %s < %t.out.luthier

# CHECK: define internal void @_Z11bumpCounterv
# At least two distinct injected-payload functions should be created (one
# per MBB in the target kernel). Each shares the "luthier.payload" base
# name, disambiguated by LLVM's numeric suffix.
# CHECK-DAG: define internal void @luthier.payload()
# CHECK-DAG: define internal void @luthier.payload.{{[0-9]+}}()
# The hook is force-inlined into each payload; its atomicrmw appears in the
# payload body instead of a call to the hook symbol.
# CHECK-DAG: atomicrmw add ptr addrspace(1) @TrivialCounter

---
TargetModule:     |
  --- |
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    define weak protected amdgpu_kernel void @vector_add(ptr addrspace(4) byref([288 x i8]) align 8 %0) #0 !luthier.entry_reg_map !2 {
      %2 = call ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr(), !luthier.reg !7
      %3 = ptrtoint ptr addrspace(4) %2 to i64, !luthier.reg !7
      %4 = call i32 @llvm.amdgcn.workgroup.id.x(), !luthier.reg !9
      %5 = call i32 @llvm.amdgcn.workitem.id.x()
      %6 = and i32 %5, 1023, !luthier.reg !11
      %7 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !13
      %8 = getelementptr i8, ptr addrspace(1) %7, i32 44, !pcsections !13
      %9 = load i32, ptr addrspace(1) %8, align 4, !pcsections !13, !luthier.reg !16
      %10 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !18
      %11 = getelementptr i8, ptr addrspace(1) %10, i32 24, !pcsections !18
      %12 = load <2 x i32>, ptr addrspace(1) %11, align 8, !pcsections !18, !luthier.reg !21
      call void @llvm.amdgcn.s.waitcnt(i32 49279), !pcsections !23
      %13 = and i32 %9, 65535, !pcsections !26, !luthier.reg !16
      %14 = icmp ne i32 %13, 0, !pcsections !26
      %15 = zext i1 %14 to i32, !pcsections !26, !luthier.reg !29
      %16 = mul i32 %4, %13, !pcsections !31, !luthier.reg !9
      %17 = extractelement <2 x i32> %12, i64 1, !amdgpu.uniform !34
      %18 = insertelement <1 x i32> poison, i32 %17, i64 0, !amdgpu.uniform !34
      %19 = bitcast <1 x i32> %18 to i32, !amdgpu.uniform !34
      %20 = extractelement <2 x i32> %12, i64 0, !amdgpu.uniform !34
      %21 = insertelement <1 x i32> poison, i32 %20, i64 0, !amdgpu.uniform !34
      %22 = bitcast <1 x i32> %21 to i32, !amdgpu.uniform !34
      br label %check
    
    check:                                            ; preds = %1
      %mbcnt.lo = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo)
      %23 = zext i32 %mbcnt.hi to i64
      %exec.shifted = lshr i64 -1, %23
      %exec.bit = and i64 %exec.shifted, 1
      %exec.is.active = trunc i64 %exec.bit to i1
      br i1 %exec.is.active, label %24, label %skip
    
    skip:                                             ; preds = %check
      br label %24
    
    24:                                               ; preds = %skip, %check
      %25 = add i32 %16, %6, !pcsections !35, !luthier.reg !11
      %26 = icmp ugt i32 %22, %25, !pcsections !38
      %27 = call i64 @llvm.amdgcn.ballot.i64(i1 %26), !pcsections !38, !luthier.reg !41
      br label %28
    
    28:                                               ; preds = %24
      %29 = and i64 %27, -1, !pcsections !43
      %30 = icmp ne i64 %29, 0, !pcsections !43
      %31 = zext i1 %30 to i32, !pcsections !43, !luthier.reg !29
      br i1 false, label %32, label %139, !pcsections !46
    
    32:                                               ; preds = %28
      %33 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !49
      %34 = load <4 x i32>, ptr addrspace(1) %33, align 16, !pcsections !49, !luthier.reg !52
      %35 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !54
      %36 = getelementptr i8, ptr addrspace(1) %35, i32 16, !pcsections !54
      %37 = load <2 x i32>, ptr addrspace(1) %36, align 8, !pcsections !54, !luthier.reg !57
      %38 = extractelement <2 x i32> %37, i64 0, !amdgpu.uniform !34
      %39 = insertelement <1 x i32> poison, i32 %38, i64 0, !amdgpu.uniform !34
      %40 = bitcast <1 x i32> %39 to i32, !amdgpu.uniform !34
      %41 = extractelement <2 x i32> %37, i64 1, !amdgpu.uniform !34
      %42 = insertelement <1 x i32> poison, i32 %41, i64 0, !amdgpu.uniform !34
      %43 = bitcast <1 x i32> %42 to i32, !amdgpu.uniform !34
      %44 = extractelement <4 x i32> %34, i64 2, !amdgpu.uniform !34
      %45 = insertelement <1 x i32> poison, i32 %44, i64 0, !amdgpu.uniform !34
      %46 = bitcast <1 x i32> %45 to i32, !amdgpu.uniform !34
      %47 = extractelement <4 x i32> %34, i64 3, !amdgpu.uniform !34
      %48 = insertelement <1 x i32> poison, i32 %47, i64 0, !amdgpu.uniform !34
      %49 = bitcast <1 x i32> %48 to i32, !amdgpu.uniform !34
      %50 = extractelement <4 x i32> %34, i64 0, !amdgpu.uniform !34
      %51 = insertelement <1 x i32> poison, i32 %50, i64 0, !amdgpu.uniform !34
      %52 = bitcast <1 x i32> %51 to i32, !amdgpu.uniform !34
      %53 = extractelement <4 x i32> %34, i64 1, !amdgpu.uniform !34
      %54 = insertelement <1 x i32> poison, i32 %53, i64 0, !amdgpu.uniform !34
      %55 = bitcast <1 x i32> %54 to i32, !amdgpu.uniform !34
      br label %check1
    
    check1:                                           ; preds = %32
      %mbcnt.lo4 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi5 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo4)
      %56 = zext i32 %mbcnt.hi5 to i64
      %exec.shifted6 = lshr i64 -1, %56
      %exec.bit7 = and i64 %exec.shifted6, 1
      %exec.is.active8 = trunc i64 %exec.bit7 to i1
      br i1 %exec.is.active8, label %57, label %skip2
    
    skip2:                                            ; preds = %check1
      br label %57
    
    57:                                               ; preds = %skip2, %check1
      %58 = call i32 @llvm.ssa.copy.i32(i32 0), !pcsections !59, !luthier.reg !62
      %59 = bitcast i32 %25 to <1 x i32>
      %60 = extractelement <1 x i32> %59, i64 0
      %61 = insertelement <2 x i32> poison, i32 %60, i64 0
      %62 = bitcast i32 %58 to <1 x i32>
      %63 = extractelement <1 x i32> %62, i64 0
      %64 = insertelement <2 x i32> %61, i32 %63, i64 1
      %65 = bitcast <2 x i32> %64 to i64
      %66 = shl i64 %65, 2, !pcsections !64, !luthier.reg !67
      %67 = bitcast i64 %66 to <2 x i32>
      %68 = extractelement <2 x i32> %67, i64 1
      %69 = insertelement <1 x i32> poison, i32 %68, i64 0
      %70 = bitcast <1 x i32> %69 to i32, !luthier.reg !62
      %71 = extractelement <2 x i32> %67, i64 0
      %72 = insertelement <1 x i32> poison, i32 %71, i64 0
      %73 = bitcast <1 x i32> %72 to i32
      br label %74
    
    74:                                               ; preds = %57
      call void @llvm.amdgcn.s.waitcnt(i32 49279), !pcsections !69
      br label %check9
    
    check9:                                           ; preds = %74
      %mbcnt.lo12 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi13 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo12)
      %75 = zext i32 %mbcnt.hi13 to i64
      %exec.shifted14 = lshr i64 -1, %75
      %exec.bit15 = and i64 %exec.shifted14, 1
      %exec.is.active16 = trunc i64 %exec.bit15 to i1
      br i1 %exec.is.active16, label %76, label %skip10
    
    skip10:                                           ; preds = %check9
      br label %76
    
    76:                                               ; preds = %skip10, %check9
      %77 = call i32 @llvm.ssa.copy.i32(i32 %55), !pcsections !72, !luthier.reg !75
      %78 = zext i32 %73 to i64, !pcsections !77
      %79 = zext i32 %52 to i64, !pcsections !77
      %80 = add i64 %79, %78, !pcsections !77
      %81 = trunc i64 %80 to i32, !pcsections !77, !luthier.reg !80
      %82 = zext i32 %70 to i64, !pcsections !82
      %83 = zext i32 %77 to i64, !pcsections !82
      %84 = add i64 %83, %82, !pcsections !82
      %85 = add i64 %84, %27, !pcsections !82
      %86 = trunc i64 %85 to i32, !pcsections !82, !luthier.reg !75
      %87 = bitcast i32 %86 to <1 x i32>
      %88 = extractelement <1 x i32> %87, i64 0
      %89 = insertelement <2 x i32> poison, i32 %88, i64 1
      %90 = bitcast i32 %81 to <1 x i32>
      %91 = extractelement <1 x i32> %90, i64 0
      %92 = insertelement <2 x i32> %89, i32 %91, i64 0
      %93 = bitcast <2 x i32> %92 to i64
      %94 = inttoptr i64 %93 to ptr addrspace(1), !pcsections !85
      %95 = load i32, ptr addrspace(1) %94, align 4, !pcsections !85, !luthier.reg !88
      %96 = call i32 @llvm.ssa.copy.i32(i32 %49), !pcsections !90, !luthier.reg !75
      %97 = zext i32 %73 to i64, !pcsections !93
      %98 = zext i32 %46 to i64, !pcsections !93
      %99 = add i64 %98, %97, !pcsections !93
      %100 = trunc i64 %99 to i32, !pcsections !93
      %101 = zext i32 %70 to i64, !pcsections !96
      %102 = zext i32 %96 to i64, !pcsections !96
      %103 = add i64 %102, %101, !pcsections !96
      %104 = add i64 %103, %27, !pcsections !96
      %105 = trunc i64 %104 to i32, !pcsections !96
      %106 = extractelement <1 x i32> %87, i64 0
      %107 = insertelement <2 x i32> poison, i32 %106, i64 1
      %108 = extractelement <1 x i32> %90, i64 0
      %109 = insertelement <2 x i32> %107, i32 %108, i64 0
      %110 = bitcast <2 x i32> %109 to i64
      %111 = inttoptr i64 %110 to ptr addrspace(1), !pcsections !99
      %112 = load i32, ptr addrspace(1) %111, align 4, !pcsections !99, !luthier.reg !80
      %113 = call i32 @llvm.ssa.copy.i32(i32 %43), !pcsections !102, !luthier.reg !75
      %114 = zext i32 %73 to i64, !pcsections !105
      %115 = zext i32 %40 to i64, !pcsections !105
      %116 = add i64 %115, %114, !pcsections !105
      %117 = trunc i64 %116 to i32, !pcsections !105, !luthier.reg !11
      %118 = zext i32 %70 to i64, !pcsections !108
      %119 = zext i32 %113 to i64, !pcsections !108
      %120 = add i64 %119, %118, !pcsections !108
      %121 = add i64 %120, %27, !pcsections !108
      %122 = trunc i64 %121 to i32, !pcsections !108, !luthier.reg !62
      %123 = bitcast i32 %122 to <1 x i32>
      %124 = extractelement <1 x i32> %123, i64 0
      %125 = insertelement <2 x i32> poison, i32 %124, i64 1
      %126 = bitcast i32 %117 to <1 x i32>
      %127 = extractelement <1 x i32> %126, i64 0
      %128 = insertelement <2 x i32> %125, i32 %127, i64 0
      %129 = bitcast <2 x i32> %128 to i64
      br label %130
    
    130:                                              ; preds = %76
      call void @llvm.amdgcn.s.waitcnt(i32 3952), !pcsections !111
      br label %check17
    
    check17:                                          ; preds = %130
      %mbcnt.lo20 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi21 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo20)
      %131 = zext i32 %mbcnt.hi21 to i64
      %exec.shifted22 = lshr i64 -1, %131
      %exec.bit23 = and i64 %exec.shifted22, 1
      %exec.is.active24 = trunc i64 %exec.bit23 to i1
      br i1 %exec.is.active24, label %132, label %skip18
    
    skip18:                                           ; preds = %check17
      br label %132
    
    132:                                              ; preds = %skip18, %check17
      %133 = bitcast i32 %112 to float, !pcsections !114
      %134 = bitcast i32 %95 to float, !pcsections !114
      %135 = bitcast i32 %19 to float, !pcsections !114
      %136 = call float @llvm.fma.f32(float %135, float %134, float %133), !pcsections !114
      %137 = bitcast float %136 to i32, !pcsections !114, !luthier.reg !80
      %138 = inttoptr i64 %129 to ptr addrspace(1), !pcsections !117
      store i32 %137, ptr addrspace(1) %138, align 4, !pcsections !117
      br label %139
    
    139:                                              ; preds = %132, %28
      call void @llvm.amdgcn.endpgm(), !pcsections !120
      unreachable, !pcsections !120
    }
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef align 4 ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef i32 @llvm.amdgcn.workgroup.id.x() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef range(i32 0, 1024) i32 @llvm.amdgcn.workitem.id.x() #1
    
    ; Function Attrs: nocallback nofree nounwind willreturn
    declare void @llvm.amdgcn.s.waitcnt(i32 immarg) #2
    
    ; Function Attrs: convergent nocallback nocreateundeforpoison nofree nounwind willreturn memory(none)
    declare i64 @llvm.amdgcn.ballot.i64(i1) #3
    
    ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.ssa.copy.i32(i32 returned) #4
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
    declare float @llvm.fma.f32(float, float, float) #5
    
    ; Function Attrs: cold convergent nocallback nofree noreturn nounwind
    declare void @llvm.amdgcn.endpgm() #6
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.amdgcn.mbcnt.lo(i32, i32) #7
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.amdgcn.mbcnt.hi(i32, i32) #7
    
    attributes #0 = { "amdgpu-dx10-clamp"="true" "amdgpu-ieee"="true" "amdgpu-implicitarg-num-bytes"="0" "amdgpu-lds-size"="0" "amdgpu-no-cluster-id-y" "amdgpu-no-cluster-id-z" "amdgpu-no-dispatch-id" "amdgpu-no-dispatch-ptr" "amdgpu-no-flat-scratch-init" "amdgpu-no-queue-ptr" "amdgpu-no-workgroup-id-y" "amdgpu-no-workgroup-id-z" "amdgpu-no-workitem-id-y" "amdgpu-no-workitem-id-z" "amdgpu-num-sgpr"="16" "amdgpu-num-vgpr"="8" "amdgpu.kd.enable_exception_address_watch"="0" "amdgpu.kd.enable_exception_fp_denormal_source"="0" "amdgpu.kd.enable_exception_ieee_754_fp_division_by_zero"="0" "amdgpu.kd.enable_exception_ieee_754_fp_inexact"="0" "amdgpu.kd.enable_exception_ieee_754_fp_invalid_operation"="0" "amdgpu.kd.enable_exception_ieee_754_fp_overflow"="0" "amdgpu.kd.enable_exception_ieee_754_fp_underflow"="0" "amdgpu.kd.enable_exception_int_divide_by_zero"="0" "amdgpu.kd.enable_exception_memory"="0" "amdgpu.kd.enable_private_segment"="0" "amdgpu.kd.enable_sgpr_workgroup_info"="0" "amdgpu.kd.enable_trap_handler"="0" "amdgpu.kd.float_round_mode_16_64"="0" "amdgpu.kd.float_round_mode_32"="0" "amdgpu.kd.fp16_ovfl"="0" "amdgpu.kd.kernarg_preload_length"="0" "amdgpu.kd.kernarg_preload_offset"="0" "amdgpu.kd.user_sgpr_count"="6" "denormal-fp-math"="ieee,ieee" "denormal-fp-math-f32"="ieee,ieee" "luthier.function.entrypoint.addr"="93978858444480" "luthier.function.initial_entrypoint" "luthier.function.initial_execution_point" }
    attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #2 = { nocallback nofree nounwind willreturn }
    attributes #3 = { convergent nocallback nocreateundeforpoison nofree nounwind willreturn memory(none) }
    attributes #4 = { nocallback nofree nosync nounwind willreturn memory(none) }
    attributes #5 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #6 = { cold convergent nocallback nofree noreturn nounwind }
    attributes #7 = { nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none) }
    
    !luthier.initial_entry_point = !{!0}
    !luthier.initial_execution_point = !{!1}
    
    !0 = !{i64 93978858444480, i1 true}
    !1 = !{i64 93978858444480}
    !2 = !{!3, !4, !5, !6}
    !3 = !{i64 -1, !"exec+h252:4", i32 323, i32 252, i32 4}
    !4 = !{i32 0, !"src_scc+h4:2", i32 37, i32 4, i32 2}
    !5 = !{i32 1008, !"mode:h2", i32 16, i32 0, i32 2}
