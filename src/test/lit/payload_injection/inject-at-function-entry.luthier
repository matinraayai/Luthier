# Verifies that, given a target HIP kernel and a pre-canonicalized IModule
# containing a single hook, the mock at-function-entry payload injection pass
# produces an IModule containing one injected payload function that calls the
# hook.
#
# Run in three steps: lift the target into a prototype, splice the hook-bearing
# IModule into it, then run the one injection pass under test. The prototype is
# carried between steps as a .luthier file, which is also what the final
# FileCheck reads.
#

# The hook function from the IModule survives the pass.

# RUN: luthier-llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 \
# RUN:    %luthier_mock_injection_plugin \
# RUN:    '-passes=luthier-mock-inject-at-function-entry' \
# RUN:    %s -o %t.out.luthier && \
# RUN: FileCheck %s < %t.out.luthier

# CHECK: define internal void @_Z11bumpCounterv
# Exactly one injected-payload function is created, named for the kernel and
# the (MBB, instr) it was attached to.
# CHECK: define internal void @luthier.payload.vector_add.{{[0-9]+}}.{{[0-9]+}}() #{{[0-9]+}} !luthier.target_instr_point {{![0-9]+}} {
# CHECK-NEXT: call void @_Z11bumpCounterv()
# CHECK-NEXT: ret void
# The payload function carries the injected_payload marker attribute.
# CHECK: "luthier.function.injected_payload"

---
TargetModule:     |
  --- |
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    define weak protected amdgpu_kernel void @vector_add(ptr addrspace(4) byref([288 x i8]) align 8 %0) #0 !luthier.entry_reg_map !2 {
      %2 = call ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr(), !luthier.reg !7
      %3 = ptrtoint ptr addrspace(4) %2 to i64, !luthier.reg !7
      %4 = call i32 @llvm.amdgcn.workgroup.id.x(), !luthier.reg !9
      %5 = call i32 @llvm.amdgcn.workitem.id.x(), !luthier.reg !11
      %6 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !13
      %7 = getelementptr i8, ptr addrspace(1) %6, i32 44, !pcsections !13
      %8 = load i32, ptr addrspace(1) %7, align 4, !pcsections !13, !luthier.reg !16
      %9 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !18
      %10 = getelementptr i8, ptr addrspace(1) %9, i32 24, !pcsections !18
      %11 = load <2 x i32>, ptr addrspace(1) %10, align 8, !pcsections !18, !luthier.reg !21
      call void @llvm.amdgcn.s.waitcnt(i32 49279), !pcsections !23
      %12 = and i32 %8, 65535, !pcsections !26, !luthier.reg !16
      %13 = icmp ne i32 %12, 0, !pcsections !26
      %14 = zext i1 %13 to i32, !pcsections !26, !luthier.reg !29
      %15 = mul i32 %4, %12, !pcsections !31, !luthier.reg !9
      %16 = extractelement <2 x i32> %11, i64 1, !amdgpu.uniform !34
      %17 = insertelement <1 x i32> poison, i32 %16, i64 0, !amdgpu.uniform !34
      %18 = bitcast <1 x i32> %17 to i32, !amdgpu.uniform !34
      %19 = extractelement <2 x i32> %11, i64 0, !amdgpu.uniform !34
      %20 = insertelement <1 x i32> poison, i32 %19, i64 0, !amdgpu.uniform !34
      %21 = bitcast <1 x i32> %20 to i32, !amdgpu.uniform !34
      br label %check
    
    check:                                            ; preds = %1
      %mbcnt.lo = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo)
      %22 = zext i32 %mbcnt.hi to i64
      %exec.shifted = lshr i64 -1, %22
      %exec.bit = and i64 %exec.shifted, 1
      %exec.is.active = trunc i64 %exec.bit to i1
      br i1 %exec.is.active, label %23, label %skip
    
    skip:                                             ; preds = %check
      br label %23
    
    23:                                               ; preds = %skip, %check
      %24 = add i32 %15, %5, !pcsections !35, !luthier.reg !11
      %25 = icmp ugt i32 %21, %24, !pcsections !38
      %26 = call i64 @llvm.amdgcn.ballot.i64(i1 %25), !pcsections !38, !luthier.reg !41
      br label %27
    
    27:                                               ; preds = %23
      %28 = and i64 %26, -1, !pcsections !43
      %29 = icmp ne i64 %28, 0, !pcsections !43
      %30 = zext i1 %29 to i32, !pcsections !43, !luthier.reg !29
      br i1 false, label %31, label %138, !pcsections !46
    
    31:                                               ; preds = %27
      %32 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !49
      %33 = load <4 x i32>, ptr addrspace(1) %32, align 16, !pcsections !49, !luthier.reg !52
      %34 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !54
      %35 = getelementptr i8, ptr addrspace(1) %34, i32 16, !pcsections !54
      %36 = load <2 x i32>, ptr addrspace(1) %35, align 8, !pcsections !54, !luthier.reg !57
      %37 = extractelement <2 x i32> %36, i64 0, !amdgpu.uniform !34
      %38 = insertelement <1 x i32> poison, i32 %37, i64 0, !amdgpu.uniform !34
      %39 = bitcast <1 x i32> %38 to i32, !amdgpu.uniform !34
      %40 = extractelement <2 x i32> %36, i64 1, !amdgpu.uniform !34
      %41 = insertelement <1 x i32> poison, i32 %40, i64 0, !amdgpu.uniform !34
      %42 = bitcast <1 x i32> %41 to i32, !amdgpu.uniform !34
      %43 = extractelement <4 x i32> %33, i64 2, !amdgpu.uniform !34
      %44 = insertelement <1 x i32> poison, i32 %43, i64 0, !amdgpu.uniform !34
      %45 = bitcast <1 x i32> %44 to i32, !amdgpu.uniform !34
      %46 = extractelement <4 x i32> %33, i64 3, !amdgpu.uniform !34
      %47 = insertelement <1 x i32> poison, i32 %46, i64 0, !amdgpu.uniform !34
      %48 = bitcast <1 x i32> %47 to i32, !amdgpu.uniform !34
      %49 = extractelement <4 x i32> %33, i64 0, !amdgpu.uniform !34
      %50 = insertelement <1 x i32> poison, i32 %49, i64 0, !amdgpu.uniform !34
      %51 = bitcast <1 x i32> %50 to i32, !amdgpu.uniform !34
      %52 = extractelement <4 x i32> %33, i64 1, !amdgpu.uniform !34
      %53 = insertelement <1 x i32> poison, i32 %52, i64 0, !amdgpu.uniform !34
      %54 = bitcast <1 x i32> %53 to i32, !amdgpu.uniform !34
      br label %check1
    
    check1:                                           ; preds = %31
      %mbcnt.lo4 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi5 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo4)
      %55 = zext i32 %mbcnt.hi5 to i64
      %exec.shifted6 = lshr i64 -1, %55
      %exec.bit7 = and i64 %exec.shifted6, 1
      %exec.is.active8 = trunc i64 %exec.bit7 to i1
      br i1 %exec.is.active8, label %56, label %skip2
    
    skip2:                                            ; preds = %check1
      br label %56
    
    56:                                               ; preds = %skip2, %check1
      %57 = call i32 @llvm.ssa.copy.i32(i32 0), !pcsections !59, !luthier.reg !62
      %58 = bitcast i32 %24 to <1 x i32>
      %59 = extractelement <1 x i32> %58, i64 0
      %60 = insertelement <2 x i32> poison, i32 %59, i64 0
      %61 = bitcast i32 %57 to <1 x i32>
      %62 = extractelement <1 x i32> %61, i64 0
      %63 = insertelement <2 x i32> %60, i32 %62, i64 1
      %64 = bitcast <2 x i32> %63 to i64
      %65 = shl i64 %64, 2, !pcsections !64, !luthier.reg !67
      %66 = bitcast i64 %65 to <2 x i32>
      %67 = extractelement <2 x i32> %66, i64 1
      %68 = insertelement <1 x i32> poison, i32 %67, i64 0
      %69 = bitcast <1 x i32> %68 to i32, !luthier.reg !62
      %70 = extractelement <2 x i32> %66, i64 0
      %71 = insertelement <1 x i32> poison, i32 %70, i64 0
      %72 = bitcast <1 x i32> %71 to i32
      br label %73
    
    73:                                               ; preds = %56
      call void @llvm.amdgcn.s.waitcnt(i32 49279), !pcsections !69
      br label %check9
    
    check9:                                           ; preds = %73
      %mbcnt.lo12 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi13 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo12)
      %74 = zext i32 %mbcnt.hi13 to i64
      %exec.shifted14 = lshr i64 -1, %74
      %exec.bit15 = and i64 %exec.shifted14, 1
      %exec.is.active16 = trunc i64 %exec.bit15 to i1
      br i1 %exec.is.active16, label %75, label %skip10
    
    skip10:                                           ; preds = %check9
      br label %75
    
    75:                                               ; preds = %skip10, %check9
      %76 = call i32 @llvm.ssa.copy.i32(i32 %54), !pcsections !72, !luthier.reg !75
      %77 = zext i32 %72 to i64, !pcsections !77
      %78 = zext i32 %51 to i64, !pcsections !77
      %79 = add i64 %78, %77, !pcsections !77
      %80 = trunc i64 %79 to i32, !pcsections !77, !luthier.reg !80
      %81 = zext i32 %69 to i64, !pcsections !82
      %82 = zext i32 %76 to i64, !pcsections !82
      %83 = add i64 %82, %81, !pcsections !82
      %84 = add i64 %83, %26, !pcsections !82
      %85 = trunc i64 %84 to i32, !pcsections !82, !luthier.reg !75
      %86 = bitcast i32 %85 to <1 x i32>
      %87 = extractelement <1 x i32> %86, i64 0
      %88 = insertelement <2 x i32> poison, i32 %87, i64 1
      %89 = bitcast i32 %80 to <1 x i32>
      %90 = extractelement <1 x i32> %89, i64 0
      %91 = insertelement <2 x i32> %88, i32 %90, i64 0
      %92 = bitcast <2 x i32> %91 to i64
      %93 = inttoptr i64 %92 to ptr addrspace(1), !pcsections !85
      %94 = load i32, ptr addrspace(1) %93, align 4, !pcsections !85, !luthier.reg !88
      %95 = call i32 @llvm.ssa.copy.i32(i32 %48), !pcsections !90, !luthier.reg !75
      %96 = zext i32 %72 to i64, !pcsections !93
      %97 = zext i32 %45 to i64, !pcsections !93
      %98 = add i64 %97, %96, !pcsections !93
      %99 = trunc i64 %98 to i32, !pcsections !93
      %100 = zext i32 %69 to i64, !pcsections !96
      %101 = zext i32 %95 to i64, !pcsections !96
      %102 = add i64 %101, %100, !pcsections !96
      %103 = add i64 %102, %26, !pcsections !96
      %104 = trunc i64 %103 to i32, !pcsections !96
      %105 = extractelement <1 x i32> %86, i64 0
      %106 = insertelement <2 x i32> poison, i32 %105, i64 1
      %107 = extractelement <1 x i32> %89, i64 0
      %108 = insertelement <2 x i32> %106, i32 %107, i64 0
      %109 = bitcast <2 x i32> %108 to i64
      %110 = inttoptr i64 %109 to ptr addrspace(1), !pcsections !99
      %111 = load i32, ptr addrspace(1) %110, align 4, !pcsections !99, !luthier.reg !80
      %112 = call i32 @llvm.ssa.copy.i32(i32 %42), !pcsections !102, !luthier.reg !75
      %113 = zext i32 %72 to i64, !pcsections !105
      %114 = zext i32 %39 to i64, !pcsections !105
      %115 = add i64 %114, %113, !pcsections !105
      %116 = trunc i64 %115 to i32, !pcsections !105, !luthier.reg !11
      %117 = zext i32 %69 to i64, !pcsections !108
      %118 = zext i32 %112 to i64, !pcsections !108
      %119 = add i64 %118, %117, !pcsections !108
      %120 = add i64 %119, %26, !pcsections !108
      %121 = trunc i64 %120 to i32, !pcsections !108, !luthier.reg !62
      %122 = bitcast i32 %121 to <1 x i32>
      %123 = extractelement <1 x i32> %122, i64 0
      %124 = insertelement <2 x i32> poison, i32 %123, i64 1
      %125 = bitcast i32 %116 to <1 x i32>
      %126 = extractelement <1 x i32> %125, i64 0
      %127 = insertelement <2 x i32> %124, i32 %126, i64 0
      %128 = bitcast <2 x i32> %127 to i64
      br label %129
    
    129:                                              ; preds = %75
      call void @llvm.amdgcn.s.waitcnt(i32 3952), !pcsections !111
      br label %check17
    
    check17:                                          ; preds = %129
      %mbcnt.lo20 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi21 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo20)
      %130 = zext i32 %mbcnt.hi21 to i64
      %exec.shifted22 = lshr i64 -1, %130
      %exec.bit23 = and i64 %exec.shifted22, 1
      %exec.is.active24 = trunc i64 %exec.bit23 to i1
      br i1 %exec.is.active24, label %131, label %skip18
    
    skip18:                                           ; preds = %check17
      br label %131
    
    131:                                              ; preds = %skip18, %check17
      %132 = bitcast i32 %111 to float, !pcsections !114
      %133 = bitcast i32 %94 to float, !pcsections !114
      %134 = bitcast i32 %18 to float, !pcsections !114
      %135 = call float @llvm.fma.f32(float %134, float %133, float %132), !pcsections !114
      %136 = bitcast float %135 to i32, !pcsections !114, !luthier.reg !80
      %137 = inttoptr i64 %128 to ptr addrspace(1), !pcsections !117
      store i32 %136, ptr addrspace(1) %137, align 4, !pcsections !117
      br label %138
    
    138:                                              ; preds = %131, %27
      call void @llvm.amdgcn.endpgm(), !pcsections !120
      unreachable, !pcsections !120
    }
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef align 4 ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef i32 @llvm.amdgcn.workgroup.id.x() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef range(i32 0, 1024) i32 @llvm.amdgcn.workitem.id.x() #1
    
    ; Function Attrs: nocallback nofree nounwind willreturn
    declare void @llvm.amdgcn.s.waitcnt(i32 immarg) #2
    
    ; Function Attrs: convergent nocallback nocreateundeforpoison nofree nounwind willreturn memory(none)
    declare i64 @llvm.amdgcn.ballot.i64(i1) #3
    
    ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.ssa.copy.i32(i32 returned) #4
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
    declare float @llvm.fma.f32(float, float, float) #5
    
    ; Function Attrs: cold convergent nocallback nofree noreturn nounwind
    declare void @llvm.amdgcn.endpgm() #6
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.amdgcn.mbcnt.lo(i32, i32) #7
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.amdgcn.mbcnt.hi(i32, i32) #7
    
    attributes #0 = { "amdgpu-dx10-clamp"="true" "amdgpu-ieee"="true" "amdgpu-implicitarg-num-bytes"="0" "amdgpu-lds-size"="0" "amdgpu-no-cluster-id-y" "amdgpu-no-cluster-id-z" "amdgpu-no-dispatch-id" "amdgpu-no-dispatch-ptr" "amdgpu-no-flat-scratch-init" "amdgpu-no-queue-ptr" "amdgpu-no-workgroup-id-y" "amdgpu-no-workgroup-id-z" "amdgpu-no-workitem-id-y" "amdgpu-no-workitem-id-z" "amdgpu-num-sgpr"="16" "amdgpu-num-vgpr"="8" "amdgpu.kd.enable_exception_address_watch"="0" "amdgpu.kd.enable_exception_fp_denormal_source"="0" "amdgpu.kd.enable_exception_ieee_754_fp_division_by_zero"="0" "amdgpu.kd.enable_exception_ieee_754_fp_inexact"="0" "amdgpu.kd.enable_exception_ieee_754_fp_invalid_operation"="0" "amdgpu.kd.enable_exception_ieee_754_fp_overflow"="0" "amdgpu.kd.enable_exception_ieee_754_fp_underflow"="0" "amdgpu.kd.enable_exception_int_divide_by_zero"="0" "amdgpu.kd.enable_exception_memory"="0" "amdgpu.kd.enable_private_segment"="0" "amdgpu.kd.enable_sgpr_workgroup_info"="0" "amdgpu.kd.enable_trap_handler"="0" "amdgpu.kd.float_round_mode_16_64"="0" "amdgpu.kd.float_round_mode_32"="0" "amdgpu.kd.fp16_ovfl"="0" "amdgpu.kd.user_sgpr_count"="6" "denormal-fp-math"="ieee,ieee" "denormal-fp-math-f32"="ieee,ieee" "luthier.function.entrypoint.addr"="94597222081216" "luthier.function.initial_entrypoint" "luthier.function.initial_execution_point" }
    attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #2 = { nocallback nofree nounwind willreturn }
    attributes #3 = { convergent nocallback nocreateundeforpoison nofree nounwind willreturn memory(none) }
    attributes #4 = { nocallback nofree nosync nounwind willreturn memory(none) }
    attributes #5 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #6 = { cold convergent nocallback nofree noreturn nounwind }
    attributes #7 = { nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none) }
    
    !luthier.initial_entry_point = !{!0}
    !luthier.initial_execution_point = !{!1}
    
