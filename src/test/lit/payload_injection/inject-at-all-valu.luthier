# Verifies the at-all-VALU mock pass creates payloads for every VALU MI in
# the target machine function. This test pins to gfx942 (CDNA3, wave64) —
# the four payload-injection tests intentionally cover four distinct
# architectures.
#

# RUN: luthier-llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx942 \
# RUN:    %luthier_mock_injection_plugin \
# RUN:    '-passes=luthier-mock-inject-at-all-valu' \
# RUN:    %s -o %t.out.luthier && \
# RUN: FileCheck %s < %t.out.luthier

# CHECK: define internal void @_Z11bumpCounterv
# Multiple injected payloads expected — VectorAdd has many VALU
# instructions on this arch. Each payload shares the "luthier.payload"
# base name, disambiguated by LLVM's numeric suffix.
# CHECK-COUNT-3: define internal void @luthier.payload

---
TargetModule:     |
  --- |
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    define weak protected amdgpu_kernel void @vector_add(ptr addrspace(4) byref([288 x i8]) align 8 %0) #0 !luthier.entry_reg_map !2 {
      %2 = call ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr(), !luthier.reg !7
      %3 = ptrtoint ptr addrspace(4) %2 to i64, !luthier.reg !7
      %4 = call i32 @llvm.amdgcn.workgroup.id.x(), !luthier.reg !9
      %5 = call i32 @llvm.amdgcn.workitem.id.x()
      %6 = and i32 %5, 1023, !luthier.reg !11
      %7 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !13
      %8 = getelementptr i8, ptr addrspace(1) %7, i32 44, !pcsections !13
      %9 = load i32, ptr addrspace(1) %8, align 4, !pcsections !13, !luthier.reg !16
      %10 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !18
      %11 = getelementptr i8, ptr addrspace(1) %10, i32 24, !pcsections !18
      %12 = load <2 x i32>, ptr addrspace(1) %11, align 8, !pcsections !18, !luthier.reg !21
      call void @llvm.amdgcn.s.waitcnt(i32 49279), !pcsections !23
      %13 = and i32 %9, 65535, !pcsections !26, !luthier.reg !16
      %14 = icmp ne i32 %13, 0, !pcsections !26
      %15 = zext i1 %14 to i32, !pcsections !26, !luthier.reg !29
      %16 = mul i32 %4, %13, !pcsections !31, !luthier.reg !9
      %17 = extractelement <2 x i32> %12, i64 1, !amdgpu.uniform !34
      %18 = insertelement <1 x i32> poison, i32 %17, i64 0, !amdgpu.uniform !34
      %19 = bitcast <1 x i32> %18 to i32, !amdgpu.uniform !34
      %20 = extractelement <2 x i32> %12, i64 0, !amdgpu.uniform !34
      %21 = insertelement <1 x i32> poison, i32 %20, i64 0, !amdgpu.uniform !34
      %22 = bitcast <1 x i32> %21 to i32, !amdgpu.uniform !34
      br label %check
    
    check:                                            ; preds = %1
      %mbcnt.lo = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo)
      %23 = zext i32 %mbcnt.hi to i64
      %exec.shifted = lshr i64 -1, %23
      %exec.bit = and i64 %exec.shifted, 1
      %exec.is.active = trunc i64 %exec.bit to i1
      br i1 %exec.is.active, label %24, label %skip
    
    skip:                                             ; preds = %check
      br label %24
    
    24:                                               ; preds = %skip, %check
      %25 = add i32 %16, %6, !pcsections !35, !luthier.reg !11
      %26 = icmp ugt i32 %22, %25, !pcsections !38
      %27 = call i64 @llvm.amdgcn.ballot.i64(i1 %26), !pcsections !38, !luthier.reg !41
      br label %28
    
    28:                                               ; preds = %24
      %29 = and i64 %27, -1, !pcsections !43
      %30 = icmp ne i64 %29, 0, !pcsections !43
      %31 = zext i1 %30 to i32, !pcsections !43, !luthier.reg !29
      br i1 false, label %32, label %76, !pcsections !46
    
    32:                                               ; preds = %28
      %33 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !49
      %34 = load <4 x i32>, ptr addrspace(1) %33, align 16, !pcsections !49, !luthier.reg !52
      %35 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !54
      %36 = getelementptr i8, ptr addrspace(1) %35, i32 16, !pcsections !54
      %37 = load <2 x i32>, ptr addrspace(1) %36, align 8, !pcsections !54, !luthier.reg !57
      %38 = bitcast <2 x i32> %37 to i64, !amdgpu.uniform !34
      %39 = bitcast <4 x i32> %34 to <2 x i64>, !amdgpu.uniform !34
      %40 = extractelement <2 x i64> %39, i64 1, !amdgpu.uniform !34
      %41 = insertelement <1 x i64> poison, i64 %40, i64 0, !amdgpu.uniform !34
      %42 = bitcast <1 x i64> %41 to i64, !amdgpu.uniform !34
      %43 = extractelement <2 x i64> %39, i64 0, !amdgpu.uniform !34
      %44 = insertelement <1 x i64> poison, i64 %43, i64 0, !amdgpu.uniform !34
      %45 = bitcast <1 x i64> %44 to i64, !amdgpu.uniform !34
      br label %check1
    
    check1:                                           ; preds = %32
      %mbcnt.lo4 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi5 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo4)
      %46 = zext i32 %mbcnt.hi5 to i64
      %exec.shifted6 = lshr i64 -1, %46
      %exec.bit7 = and i64 %exec.shifted6, 1
      %exec.is.active8 = trunc i64 %exec.bit7 to i1
      br i1 %exec.is.active8, label %47, label %skip2
    
    skip2:                                            ; preds = %check1
      br label %47
    
    47:                                               ; preds = %skip2, %check1
      %48 = call i32 @llvm.ssa.copy.i32(i32 0), !pcsections !59, !luthier.reg !62
      %49 = bitcast i32 %25 to <1 x i32>
      %50 = extractelement <1 x i32> %49, i64 0
      %51 = insertelement <2 x i32> poison, i32 %50, i64 0
      %52 = bitcast i32 %48 to <1 x i32>
      %53 = extractelement <1 x i32> %52, i64 0
      %54 = insertelement <2 x i32> %51, i32 %53, i64 1
      %55 = bitcast <2 x i32> %54 to i64
      %56 = shl i64 %55, 2, !pcsections !64, !luthier.reg !67
      br label %57
    
    57:                                               ; preds = %47
      call void @llvm.amdgcn.s.waitcnt(i32 49279), !pcsections !69
      br label %check9
    
    check9:                                           ; preds = %57
      %mbcnt.lo12 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi13 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo12)
      %58 = zext i32 %mbcnt.hi13 to i64
      %exec.shifted14 = lshr i64 -1, %58
      %exec.bit15 = and i64 %exec.shifted14, 1
      %exec.is.active16 = trunc i64 %exec.bit15 to i1
      br i1 %exec.is.active16, label %59, label %skip10
    
    skip10:                                           ; preds = %check9
      br label %59
    
    59:                                               ; preds = %skip10, %check9
      %60 = add i64 %45, %56, !pcsections !72, !luthier.reg !75
      %61 = add i64 %42, %56, !pcsections !77, !luthier.reg !80
      %62 = inttoptr i64 %60 to ptr addrspace(1), !pcsections !82
      %63 = load i32, ptr addrspace(1) %62, align 4, !pcsections !82, !luthier.reg !85
      %64 = inttoptr i64 %61 to ptr addrspace(1), !pcsections !87
      %65 = load i32, ptr addrspace(1) %64, align 4, !pcsections !87, !luthier.reg !90
      %66 = add i64 %38, %56, !pcsections !92, !luthier.reg !67
      br label %67
    
    67:                                               ; preds = %59
      call void @llvm.amdgcn.s.waitcnt(i32 3952), !pcsections !95
      br label %check17
    
    check17:                                          ; preds = %67
      %mbcnt.lo20 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %mbcnt.hi21 = call i32 @llvm.amdgcn.mbcnt.hi(i32 -1, i32 %mbcnt.lo20)
      %68 = zext i32 %mbcnt.hi21 to i64
      %exec.shifted22 = lshr i64 -1, %68
      %exec.bit23 = and i64 %exec.shifted22, 1
      %exec.is.active24 = trunc i64 %exec.bit23 to i1
      br i1 %exec.is.active24, label %69, label %skip18
    
    skip18:                                           ; preds = %check17
      br label %69
    
    69:                                               ; preds = %skip18, %check17
      %70 = bitcast i32 %65 to float, !pcsections !98
      %71 = bitcast i32 %63 to float, !pcsections !98
      %72 = bitcast i32 %19 to float, !pcsections !98
      %73 = call float @llvm.fma.f32(float %72, float %71, float %70), !pcsections !98
      %74 = bitcast float %73 to i32, !pcsections !98, !luthier.reg !90
      %75 = inttoptr i64 %66 to ptr addrspace(1), !pcsections !101
      store i32 %74, ptr addrspace(1) %75, align 4, !pcsections !101
      br label %76
    
    76:                                               ; preds = %69, %28
      call void @llvm.amdgcn.endpgm(), !pcsections !104
      unreachable, !pcsections !104
    }
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef align 4 ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef i32 @llvm.amdgcn.workgroup.id.x() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef range(i32 0, 1024) i32 @llvm.amdgcn.workitem.id.x() #1
    
    ; Function Attrs: nocallback nofree nounwind willreturn
    declare void @llvm.amdgcn.s.waitcnt(i32 immarg) #2
    
    ; Function Attrs: convergent nocallback nocreateundeforpoison nofree nounwind willreturn memory(none)
    declare i64 @llvm.amdgcn.ballot.i64(i1) #3
    
    ; Function Attrs: nocallback nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.ssa.copy.i32(i32 returned) #4
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none)
    declare float @llvm.fma.f32(float, float, float) #5
    
    ; Function Attrs: cold convergent nocallback nofree noreturn nounwind
    declare void @llvm.amdgcn.endpgm() #6
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.amdgcn.mbcnt.lo(i32, i32) #7
    
    ; Function Attrs: nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none)
    declare i32 @llvm.amdgcn.mbcnt.hi(i32, i32) #7
    
    attributes #0 = { "amdgpu-dx10-clamp"="true" "amdgpu-ieee"="true" "amdgpu-implicitarg-num-bytes"="0" "amdgpu-lds-size"="0" "amdgpu-no-cluster-id-y" "amdgpu-no-cluster-id-z" "amdgpu-no-dispatch-id" "amdgpu-no-dispatch-ptr" "amdgpu-no-flat-scratch-init" "amdgpu-no-queue-ptr" "amdgpu-no-workgroup-id-y" "amdgpu-no-workgroup-id-z" "amdgpu-no-workitem-id-y" "amdgpu-no-workitem-id-z" "amdgpu-num-sgpr"="24" "amdgpu-num-vgpr"="8" "amdgpu.kd.enable_exception_address_watch"="0" "amdgpu.kd.enable_exception_fp_denormal_source"="0" "amdgpu.kd.enable_exception_ieee_754_fp_division_by_zero"="0" "amdgpu.kd.enable_exception_ieee_754_fp_inexact"="0" "amdgpu.kd.enable_exception_ieee_754_fp_invalid_operation"="0" "amdgpu.kd.enable_exception_ieee_754_fp_overflow"="0" "amdgpu.kd.enable_exception_ieee_754_fp_underflow"="0" "amdgpu.kd.enable_exception_int_divide_by_zero"="0" "amdgpu.kd.enable_exception_memory"="0" "amdgpu.kd.enable_private_segment"="0" "amdgpu.kd.enable_sgpr_workgroup_info"="0" "amdgpu.kd.enable_trap_handler"="0" "amdgpu.kd.float_round_mode_16_64"="0" "amdgpu.kd.float_round_mode_32"="0" "amdgpu.kd.fp16_ovfl"="0" "amdgpu.kd.kernarg_preload_length"="0" "amdgpu.kd.kernarg_preload_offset"="0" "amdgpu.kd.user_sgpr_count"="2" "denormal-fp-math"="ieee,ieee" "denormal-fp-math-f32"="ieee,ieee" "luthier.function.entrypoint.addr"="94904903714496" "luthier.function.initial_entrypoint" "luthier.function.initial_execution_point" }
    attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #2 = { nocallback nofree nounwind willreturn }
    attributes #3 = { convergent nocallback nocreateundeforpoison nofree nounwind willreturn memory(none) }
    attributes #4 = { nocallback nofree nosync nounwind willreturn memory(none) }
    attributes #5 = { nocallback nocreateundeforpoison nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #6 = { cold convergent nocallback nofree noreturn nounwind }
    attributes #7 = { nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none) }
    
    !luthier.initial_entry_point = !{!0}
    !luthier.initial_execution_point = !{!1}
    
    !0 = !{i64 94904903714496, i1 true}
    !1 = !{i64 94904903714496}
    !2 = !{!3, !4, !5, !6}
    !3 = !{i64 -1, !"exec+h252:4", i32 323, i32 252, i32 4}
    !4 = !{i32 0, !"src_scc+h4:2", i32 37, i32 4, i32 2}
    !5 = !{i32 1008, !"mode:h2", i32 16, i32 0, i32 2}
