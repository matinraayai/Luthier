    skip16:                                           ; preds = %check15
      br label %98
    
    98:                                               ; preds = %skip16, %check15
      %99 = zext i32 %96 to i64, !pcsections !76
      %100 = zext i32 %70 to i64, !pcsections !76
      %101 = add i64 %100, %99, !pcsections !76
      %102 = trunc i64 %101 to i32, !pcsections !76, !luthier.reg !60
      br label %103
    
    103:                                              ; preds = %98
      call void @llvm.amdgcn.s.waitcnt(i32 0), !pcsections !79
      br label %check22
    
    check22:                                          ; preds = %103
      %mbcnt.lo25 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %exec.shifted26 = lshr i32 -1, %mbcnt.lo25
      %exec.bit27 = and i32 %exec.shifted26, 1
      %exec.is.active28 = trunc i32 %exec.bit27 to i1
