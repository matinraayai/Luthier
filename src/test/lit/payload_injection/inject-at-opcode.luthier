      %112 = add i64 %111, %110, !pcsections !87
      %113 = trunc i64 %112 to i32, !pcsections !87, !luthier.reg !90
      %114 = zext i32 %93 to i64, !pcsections !92
      %115 = zext i32 %61 to i64, !pcsections !92
      %116 = add i64 %115, %114, !pcsections !92
      %117 = add i64 %116, %54, !pcsections !92
      %118 = trunc i64 %117 to i32, !pcsections !92, !luthier.reg !95
      %119 = zext i32 %96 to i64, !pcsections !97
      %120 = zext i32 %87 to i64, !pcsections !97
      %121 = add i64 %120, %119, !pcsections !97
      %122 = trunc i64 %121 to i32, !pcsections !97, !luthier.reg !9
      %123 = bitcast i32 %102 to <1 x i32>
      %124 = extractelement <1 x i32> %123, i64 0
      %125 = insertelement <2 x i32> poison, i32 %124, i64 0
      %126 = bitcast i32 %109 to <1 x i32>
      %127 = extractelement <1 x i32> %126, i64 0
      %128 = insertelement <2 x i32> %125, i32 %127, i64 1
      %129 = bitcast <2 x i32> %128 to i64
      %130 = inttoptr i64 %129 to ptr addrspace(1), !pcsections !100
      %131 = load i32, ptr addrspace(1) %130, align 4, !pcsections !100, !luthier.reg !60
      %132 = bitcast i32 %118 to <1 x i32>
      %133 = extractelement <1 x i32> %132, i64 0
      %134 = insertelement <2 x i32> poison, i32 %133, i64 1
