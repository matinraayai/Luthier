# Verifies the at-opcode mock pass creates a payload for every MI whose
# mnemonic contains the user-supplied substring (passed via
# -luthier-mock-inject-opcode). The kernel has exactly one v_fmac_f32, so
# one payload is expected. This test pins to gfx1100 (RDNA3, wave32) —
# the four payload-injection tests intentionally cover four distinct
# architectures including both wave64 (CDNA) and wave32 (RDNA) lifts.
#

# RUN: luthier-llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 \
# RUN:    %luthier_mock_injection_plugin \
# RUN:    '-passes=luthier-mock-inject-at-opcode' \
# RUN:    -luthier-mock-inject-opcode=V_FMAC_F32 \
# RUN:    %s -o %t.out.luthier && \
# RUN: FileCheck %s < %t.out.luthier

# CHECK: define internal void @_Z11bumpCounterv
# CHECK-COUNT-1: define internal void @luthier.payload.vector_add.
# CHECK-NOT:    define internal void @luthier.payload.vector_add.{{.*}}

---
TargetModule:     |
  --- |
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    define weak protected amdgpu_kernel void @vector_add(ptr addrspace(4) byref([288 x i8]) align 8 %0) #0 !luthier.entry_reg_map !2 {
      %2 = call ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr(), !luthier.reg !7
      %3 = ptrtoint ptr addrspace(4) %2 to i64, !luthier.reg !7
      %4 = call i32 @llvm.amdgcn.workitem.id.x()
      %5 = and i32 %4, 1023, !luthier.reg !9
      call void @llvm.amdgcn.s.waitcnt(i32 0), !pcsections !11
      %6 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !14
      %7 = getelementptr i8, ptr addrspace(1) %6, i32 44, !pcsections !14
      %8 = load i32, ptr addrspace(1) %7, align 4, !pcsections !14, !luthier.reg !17
      %9 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !19
      %10 = getelementptr i8, ptr addrspace(1) %9, i32 24, !pcsections !19
      %11 = load <2 x i32>, ptr addrspace(1) %10, align 8, !pcsections !19, !luthier.reg !22
      call void @llvm.amdgcn.s.waitcnt(i32 64519), !pcsections !24
      %12 = and i32 %8, 65535, !pcsections !27, !luthier.reg !17
      %13 = icmp ne i32 %12, 0, !pcsections !27
      %14 = zext i1 %13 to i32, !pcsections !27, !luthier.reg !30
      call void @llvm.amdgcn.s.waitcnt(i32 0), !pcsections !32
      %15 = extractelement <2 x i32> %11, i64 1, !amdgpu.uniform !35
      %16 = insertelement <1 x i32> poison, i32 %15, i64 0, !amdgpu.uniform !35
      %17 = bitcast <1 x i32> %16 to i32, !amdgpu.uniform !35
      %18 = freeze i32 poison, !amdgpu.uniform !35
      %19 = extractelement <2 x i32> %11, i64 0, !amdgpu.uniform !35
      %20 = insertelement <1 x i32> poison, i32 %19, i64 0, !amdgpu.uniform !35
      %21 = bitcast <1 x i32> %20 to i32, !amdgpu.uniform !35
      %22 = freeze i32 poison, !amdgpu.uniform !35
      %23 = freeze i32 poison
      %24 = bitcast i32 %23 to <1 x i32>
      %25 = extractelement <1 x i32> %24, i64 0
      %26 = insertelement <2 x i32> poison, i32 %25, i64 1
      %27 = bitcast i32 %5 to <1 x i32>
      %28 = extractelement <1 x i32> %27, i64 0
      %29 = insertelement <2 x i32> %26, i32 %28, i64 0
      %30 = bitcast <2 x i32> %29 to i64
      br label %check
    
    check:                                            ; preds = %1
      %mbcnt.lo = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %exec.shifted = lshr i32 -1, %mbcnt.lo
      %exec.bit = and i32 %exec.shifted, 1
      %exec.is.active = trunc i32 %exec.bit to i1
      br i1 %exec.is.active, label %31, label %skip
    
    skip:                                             ; preds = %check
      br label %31
    
    31:                                               ; preds = %skip, %check
      %32 = zext i32 %12 to i64, !pcsections !36
      %33 = zext i32 %22 to i64, !pcsections !36
      %34 = mul i64 %33, %32, !pcsections !36
      %35 = add i64 %34, %30, !pcsections !36, !luthier.reg !39
      %36 = bitcast i64 %35 to <2 x i32>
      %37 = extractelement <2 x i32> %36, i64 0
      %38 = insertelement <1 x i32> poison, i32 %37, i64 0
      %39 = bitcast <1 x i32> %38 to i32
      %40 = icmp ugt i32 %21, %39, !pcsections !41
      %41 = call i32 @llvm.amdgcn.ballot.i32(i1 %40), !pcsections !41
      %42 = zext i32 %41 to i64, !luthier.reg !44, !amdgpu.uniform !35
      %43 = bitcast i64 %42 to <2 x i32>, !amdgpu.uniform !35
      %44 = extractelement <2 x i32> %43, i64 1, !amdgpu.uniform !35
      %45 = extractelement <2 x i32> %43, i64 0, !amdgpu.uniform !35
      %46 = insertelement <1 x i32> poison, i32 %45, i64 0, !amdgpu.uniform !35
      %47 = bitcast <1 x i32> %46 to i32, !amdgpu.uniform !35
      br label %48
    
    48:                                               ; preds = %31
      %49 = and i32 %47, -1, !pcsections !46
      %50 = icmp ne i32 %49, 0, !pcsections !46
      %51 = zext i1 %50 to i32, !pcsections !46, !luthier.reg !30
      %52 = insertelement <2 x i32> poison, i32 %44, i64 1, !amdgpu.uniform !35
      %53 = insertelement <2 x i32> %52, i32 %45, i64 0, !amdgpu.uniform !35
      %54 = bitcast <2 x i32> %53 to i64, !amdgpu.uniform !35
      br i1 false, label %55, label %161, !pcsections !49
    
    55:                                               ; preds = %48
      %56 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !52
      %57 = getelementptr i8, ptr addrspace(1) %56, i32 %18, !pcsections !52
      %58 = load <4 x i32>, ptr addrspace(1) %57, align 16, !pcsections !52, !luthier.reg !55
      %59 = extractelement <4 x i32> %58, i64 3, !amdgpu.uniform !35
      %60 = insertelement <1 x i32> poison, i32 %59, i64 0, !amdgpu.uniform !35
      %61 = bitcast <1 x i32> %60 to i32, !amdgpu.uniform !35
      %62 = extractelement <4 x i32> %58, i64 2, !amdgpu.uniform !35
      %63 = insertelement <1 x i32> poison, i32 %62, i64 0, !amdgpu.uniform !35
      %64 = bitcast <1 x i32> %63 to i32, !amdgpu.uniform !35
      %65 = extractelement <4 x i32> %58, i64 1, !amdgpu.uniform !35
      %66 = insertelement <1 x i32> poison, i32 %65, i64 0, !amdgpu.uniform !35
      %67 = bitcast <1 x i32> %66 to i32, !amdgpu.uniform !35
      %68 = extractelement <4 x i32> %58, i64 0, !amdgpu.uniform !35
      %69 = insertelement <1 x i32> poison, i32 %68, i64 0, !amdgpu.uniform !35
      %70 = bitcast <1 x i32> %69 to i32, !amdgpu.uniform !35
      br label %check1
    
    check1:                                           ; preds = %55
      %mbcnt.lo4 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %exec.shifted5 = lshr i32 -1, %mbcnt.lo4
      %exec.bit6 = and i32 %exec.shifted5, 1
      %exec.is.active7 = trunc i32 %exec.bit6 to i1
      br i1 %exec.is.active7, label %71, label %skip2
    
    skip2:                                            ; preds = %check1
      br label %71
    
    71:                                               ; preds = %skip2, %check1
      %72 = call i32 @llvm.ssa.copy.i32(i32 0), !pcsections !57, !luthier.reg !60
      %73 = insertelement <2 x i32> poison, i32 %37, i64 0
      %74 = bitcast i32 %72 to <1 x i32>
      %75 = extractelement <1 x i32> %74, i64 0
      %76 = insertelement <2 x i32> %73, i32 %75, i64 1
      %77 = bitcast <2 x i32> %76 to i64
      br label %78
    
    78:                                               ; preds = %71
      %79 = inttoptr i64 %3 to ptr addrspace(1), !pcsections !62
      %80 = getelementptr i8, ptr addrspace(1) %79, i32 16, !pcsections !62
      %81 = load <2 x i32>, ptr addrspace(1) %80, align 8, !pcsections !62, !luthier.reg !7
      call void @llvm.amdgcn.s.waitcnt(i32 0), !pcsections !65
      %82 = extractelement <2 x i32> %81, i64 1, !amdgpu.uniform !35
      %83 = insertelement <1 x i32> poison, i32 %82, i64 0, !amdgpu.uniform !35
      %84 = bitcast <1 x i32> %83 to i32, !amdgpu.uniform !35
      %85 = extractelement <2 x i32> %81, i64 0, !amdgpu.uniform !35
      %86 = insertelement <1 x i32> poison, i32 %85, i64 0, !amdgpu.uniform !35
      %87 = bitcast <1 x i32> %86 to i32, !amdgpu.uniform !35
      br label %check8
    
    check8:                                           ; preds = %78
      %mbcnt.lo11 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %exec.shifted12 = lshr i32 -1, %mbcnt.lo11
      %exec.bit13 = and i32 %exec.shifted12, 1
      %exec.is.active14 = trunc i32 %exec.bit13 to i1
      br i1 %exec.is.active14, label %88, label %skip9
    
    skip9:                                            ; preds = %check8
      br label %88
    
    88:                                               ; preds = %skip9, %check8
      %89 = shl i64 %77, 2, !pcsections !68, !luthier.reg !71
      %90 = bitcast i64 %89 to <2 x i32>
      %91 = extractelement <2 x i32> %90, i64 1
      %92 = insertelement <1 x i32> poison, i32 %91, i64 0
      %93 = bitcast <1 x i32> %92 to i32
      %94 = extractelement <2 x i32> %90, i64 0
      %95 = insertelement <1 x i32> poison, i32 %94, i64 0
      %96 = bitcast <1 x i32> %95 to i32
      br label %97
    
    97:                                               ; preds = %88
      call void @llvm.amdgcn.s.waitcnt(i32 64519), !pcsections !73
      br label %check15
    
    check15:                                          ; preds = %97
      %mbcnt.lo18 = call i32 @llvm.amdgcn.mbcnt.lo(i32 -1, i32 0)
      %exec.shifted19 = lshr i32 -1, %mbcnt.lo18
      %exec.bit20 = and i32 %exec.shifted19, 1
      %exec.is.active21 = trunc i32 %exec.bit20 to i1
