# RUN: luthier-llc -x mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 \
# RUN:   %luthier_tool_code_gen_plugin \
# RUN:   '-passes=luthier-flush-translation-test,print' \
# RUN:   %s -o /dev/null 2>&1 | %tee_out FileCheck --check-prefix=DIRTY %s
# RUN: sed 's/i1 true/i1 false/' %s > %t.clean.mir && \
# RUN: luthier-llc -x mir -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 \
# RUN:   %luthier_tool_code_gen_plugin \
# RUN:   '-passes=luthier-flush-translation-test,print' \
# RUN:   %t.clean.mir -o /dev/null 2>&1 | %tee_out FileCheck --check-prefix=CLEAN %s

# Plain-MIR cold-path test for TranslationState: the needs_retranslation
# mark is written directly in the fixture's metadata (no discovery, no .s
# round trip). A fresh TranslationState must rebuild its dirty set from
# the parsed metadata, flush via a full re-lift, and clear the mark. With
# the mark cleared (i1 false), the flush must be a no-op: the dummy IR
# body in the fixture is kept verbatim.

# DIRTY: define amdgpu_kernel void @k()
# DIRTY: call i32 @llvm.ssa.copy.i32(i32 0)
# DIRTY: call void @llvm.amdgcn.endpgm()
# DIRTY-NOT: !{i1 true}

# CLEAN: define amdgpu_kernel void @k()
# CLEAN-NOT: llvm.ssa.copy

--- |
  target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @k() #0 {
  body:
    unreachable
  }

  attributes #0 = { "amdgpu-num-sgpr"="16" "amdgpu-num-vgpr"="8" "amdgpu-no-dispatch-ptr" "amdgpu-no-queue-ptr" "amdgpu-no-flat-scratch-init" "amdgpu.kd.user_sgpr_count"="2" }

  !0 = distinct !{!"luthier.machine_instr.tag", !1, !"luthier.machine_instr.trace_addr", !2, !"luthier.machine_instr.needs_retranslation", !3}
  !1 = distinct !{i64 undef, i64 2, i64 undef, i64 4}
  !2 = distinct !{i64 4096}
  !3 = distinct !{i1 true}
  !4 = distinct !{!"luthier.machine_instr.tag", !5, !"luthier.machine_instr.trace_addr", !6}
  !5 = distinct !{i64 undef, i64 2}
  !6 = distinct !{i64 4100}
...
---
name:            k
alignment:       256
tracksRegLiveness: true
machineFunctionInfo: {}
body: |
  bb.0 (%ir-block.body):
    $sgpr0 = S_MOV_B32 0, pcsections !0
    S_ENDPGM 0, pcsections !4
...
