import os

config.my_src_root = r'@CMAKE_CURRENT_SOURCE_DIR@'
config.my_obj_root = r'@CMAKE_CURRENT_BINARY_DIR@'

# Needed for clang, llvm-dis, etc.
config.environment['PATH'] = os.pathsep.join(["@LLVM_TOOLS_BINARY_DIR@",
                                              config.environment['PATH']])

# Needed for Luthier binaries
config.environment['PATH'] = os.pathsep.join(["@CMAKE_BINARY_DIR@/bin",
                                              config.environment['PATH']])

lit_config.load_config(
      config, os.path.join(config.my_src_root, "lit.cfg.py"))


# NOTE: there is deliberately no %luthier_tool_code_gen_plugin substitution.
# The ToolCodeGen passes are linked directly into luthier-llc, so tests must not
# load them as a plugin.

tool_ir_compilation_plugin_path = os.path.join("@CMAKE_BINARY_DIR@/lib",
                                 "LuthierToolIRCompilationPlugin.so")
config.substitutions.append(
    ('%luthier_tool_ir_compilation_plugin_path', tool_ir_compilation_plugin_path))

tool_cxx_compilation_plugin_path = os.path.join("@CMAKE_BINARY_DIR@/lib",
                                       "LuthierToolCXXCompilationPlugin.so")
config.substitutions.append(
    ('%luthier_tool_cxx_compilation_plugin_path', tool_cxx_compilation_plugin_path))

config.substitutions.append(('%clangxx', "@LLVM_TOOLS_BINARY_DIR@/clang++"))

config.substitutions.append(('%luthier_split_test',
    os.path.join("@CMAKE_BINARY_DIR@/bin", "luthier-split-test")))

mock_injection_plugin_path = os.path.join("@CMAKE_BINARY_DIR@/lib",
                                          "LuthierMockInjectionPlugin.so")
# A single -load-pass-plugin= is enough: luthier::PassPlugin::Load dlopens the
# shared object (registering its cl::opt globals, so options like
# -luthier-mock-inject-opcode are accepted) and then invokes the plugin's
# RegisterPrototypePassBuilderCallback, which is what teaches the
# InstrumentationPassBuilder to resolve the mock pass names while parsing
# -passes. The old -load= / -luthier-plugin= pair is gone along with
# InstrumentationPMDriver.
config.substitutions.append(
    ('%luthier_mock_injection_plugin',
     f"-load-pass-plugin={mock_injection_plugin_path}"))

config.substitutions.append(
    ('%luthier_test_imodule_dir', "@CMAKE_BINARY_DIR@/test/imodule"))

config.substitutions.append(
    ('%intrinsic_mir_lowering_target_stub',
     "@CMAKE_CURRENT_SOURCE_DIR@/intrinsic_mir_lowering/_target_stub.s.txt"))
