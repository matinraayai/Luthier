    define void @luthier.payload.tiny() #0 {
      %1 = call i32 asm sideeffect "luthier.placeholder.0", "=s"()
      ret void
    }
    
    attributes #0 = { naked noinline "luthier.function.injected_payload" "target-cpu"="gfx908" "target-features"="+wavefrontsize64" }
    
    !luthier.intrinsic.placeholders = !{!0}
    !luthier.sva.private_segment_wave_byte_offset = !{}
    
    !0 = !{!"luthier.placeholder.0", !"luthier::readSVA", !1, !2}
    !1 = !{i32 4}
    !2 = !{!1, !3, !3}
    !3 = !{}
