# Exercises the SVASpillCallback path in LuthierRegScavenger.
#
# Custom target stub (_target_stub_branch_relax.s.txt) defines s4..s101
# at function entry and uses them again after a forward branch. With
# --amdgpu-s-branch-bits=4 the branch is over-range and
# LuthierBranchRelaxation::fixupConditionalBranch runs. Every SReg_64
# pair in the allocation order has at least one half live across the
# branch insertion point, so the LuthierRegScavenger's
# findSurvivorBackwards loop cannot return Reg != 0 with SpillBefore =
# end() — it falls through to the spill path. Stock LLVM would then
# emit a FrameIndex-based spill, but our patcher installed an
# SVASpillCallback, so V_WRITELANE_B32 + V_READLANE_B32 against the
# SVA storage VGPR fire instead.
#
# This is the validation test deferred from task #30. It pins down
# that the entire chain — LuthierBranchRelaxation calling
# emitLuthierLongBranch calling LuthierRegScavenger.spill calling
# SVASpillCallback — actually fires when the natural scavenger fails.

# XFAIL: *
# The assertions below need the patcher to actually outline this payload —
# an s_branch per instrumentation point, relaxed to s_setpc_b64, plus the
# SVA writelane/readlane spill. Two things stop that from being reachable
# today, both independent of how this test is spelled:
#
#   1. The IModule below defines no hook, so luthier-mock-inject-at-mbb-entry
#      has nothing to bind and creates no target-bound payload;
#      luthier.payload.tiny carries no !luthier.target_instr_point either.
#   2. Even with a bound payload, a .luthier round-trip drops the binding:
#      InjectedPayloadAndInstPointAnalysis matches a payload to its AppMI by
#      MDNode pointer identity, and writeLuthierFile's MDSlotMap is built
#      from IR metadata only, so a pcsections node hanging off a MachineInstr
#      is never recorded and never re-linked on load. The patcher therefore
#      sees an empty payload map and emits no s_branch at all.
#
# The pipeline itself runs clean to completion, so this is an output-
# verification XFAIL like injected_payload_pei/regalloc-pressure-lowered.ll.
# RUN: luthier-llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 \
# RUN:    -amdgpu-s-branch-bits=4 \
# RUN:    '-passes=luthier-target-module-patcher,target(luthier-asm-printer)' \
# RUN:    %s -o /dev/null > %t.asm 2>&1 && \
# RUN: FileCheck %s < %t.asm

# Sanity: AsmPrinter ran (header marker).
# CHECK: .amdgcn_target

# Long-jump trampoline emitted by emitLuthierLongBranch (lower-cased
# AMDGPU asm mnemonics).
# CHECK: s_getpc_b64
# CHECK: s_setpc_b64

# SVA-lane spill+reload from the callback. Match loosely — the lane
# numbers depend on findLowestFreeLanes, and the SGPR pair the
# scavenger picks isn't pinned. The presence of both mnemonics in the
# emitted assembly proves the callback fired.
# CHECK: v_writelane_b32
# CHECK: v_readlane_b32
---
TargetModule:     |
  --- |
    ; ModuleID = 'branch-relax-sva-spill.instrumentation_module'
    source_filename = "branch-relax-sva-spill.instrumentation_module"
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    define weak protected amdgpu_kernel void @stub_kernel() #0 !luthier.entry_reg_map !2 {
      call void @llvm.amdgcn.endpgm(), !pcsections !7
      unreachable, !pcsections !7
    }
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef i32 @llvm.amdgcn.workgroup.id.x() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef range(i32 0, 1024) i32 @llvm.amdgcn.workitem.id.x() #1
    
    ; Function Attrs: cold convergent nocallback nofree noreturn nounwind
    declare void @llvm.amdgcn.endpgm() #2
    
    attributes #0 = { "amdgpu-dx10-clamp"="true" "amdgpu-ieee"="true" "amdgpu-implicitarg-num-bytes"="0" "amdgpu-lds-size"="0" "amdgpu-no-cluster-id-y" "amdgpu-no-cluster-id-z" "amdgpu-no-dispatch-id" "amdgpu-no-dispatch-ptr" "amdgpu-no-flat-scratch-init" "amdgpu-no-kernarg-segment-ptr" "amdgpu-no-queue-ptr" "amdgpu-no-workgroup-id-y" "amdgpu-no-workgroup-id-z" "amdgpu-no-workitem-id-y" "amdgpu-no-workitem-id-z" "amdgpu-num-sgpr"="8" "amdgpu-num-vgpr"="4" "amdgpu.kd.enable_exception_address_watch"="0" "amdgpu.kd.enable_exception_fp_denormal_source"="0" "amdgpu.kd.enable_exception_ieee_754_fp_division_by_zero"="0" "amdgpu.kd.enable_exception_ieee_754_fp_inexact"="0" "amdgpu.kd.enable_exception_ieee_754_fp_invalid_operation"="0" "amdgpu.kd.enable_exception_ieee_754_fp_overflow"="0" "amdgpu.kd.enable_exception_ieee_754_fp_underflow"="0" "amdgpu.kd.enable_exception_int_divide_by_zero"="0" "amdgpu.kd.enable_exception_memory"="0" "amdgpu.kd.enable_private_segment"="0" "amdgpu.kd.enable_sgpr_workgroup_info"="0" "amdgpu.kd.enable_trap_handler"="0" "amdgpu.kd.float_round_mode_16_64"="0" "amdgpu.kd.float_round_mode_32"="0" "amdgpu.kd.fp16_ovfl"="0" "amdgpu.kd.user_sgpr_count"="0" "denormal-fp-math"="ieee,ieee" "denormal-fp-math-f32"="preserve-sign,preserve-sign" "luthier.function.entrypoint.addr"="94706243691264" "luthier.function.initial_entrypoint" "luthier.function.initial_execution_point" "target-cpu"="gfx908" }
    attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) "target-cpu"="gfx908" }
    attributes #2 = { cold convergent nocallback nofree noreturn nounwind "target-cpu"="gfx908" }
    
    !luthier.initial_entry_point = !{!0}
    !luthier.initial_execution_point = !{!1}
    
    !0 = !{i64 94706243691264, i1 true}
    !1 = !{i64 94706243691264}
    !2 = !{!3, !4, !5, !6}
    !3 = !{i64 -1, !"exec+h252:4", i32 323, i32 252, i32 4}
    !4 = !{i32 0, !"src_scc+h4:2", i32 37, i32 4, i32 2}
    !5 = !{i32 960, !"mode:h2", i32 16, i32 0, i32 2}
    !6 = !{i64 0, !"sgpr[6:7]", i32 324, i32 12, i32 4}
    !7 = distinct !{!"luthier.machine_instr.tag", !8, !"luthier.machine_instr.trace_addr", !9}
    !8 = distinct !{i64 undef, i64 2}
    !9 = distinct !{i64 94706243695616}
  ...
  ---
  name:            stub_kernel
  alignment:       256
  exposesReturnsTwice: false
  legalized:       false
  regBankSelected: false
