    stackPtrOffsetReg: '$sp_reg'
    bytesInStackArgArea: 0
    returnsVoid:     true
    argumentInfo:
      workGroupIDX:    { reg: '$sgpr0' }
      privateSegmentWaveByteOffset: { reg: '$sgpr1' }
      workItemIDX:     { reg: '$vgpr0' }
    psInputAddr:     0
    psInputEnable:   0
    maxMemoryClusterDWords: 8
    mode:
      ieee:            true
      dx10-clamp:      true
      fp32-input-denormals: true
      fp32-output-denormals: true
      fp64-fp16-input-denormals: true
      fp64-fp16-output-denormals: true
    highBitsOf32BitAddress: 0
    occupancy:       10
    vgprForAGPRCopy: '$vgpr3'
    sgprForEXECCopy: ''
    longBranchReservedReg: ''
    hasInitWholeWave: false
    dynamicVGPRBlockSize: 0
    scratchReservedForDynamicVGPRs: 0
    numKernargPreloadSGPRs: 0
    isWholeWaveFunction: false
    minNumAGPRs:     4294967295
  body:             |
    bb.0 (%ir-block.0):
      S_ENDPGM 0, pcsections !7
  ...
