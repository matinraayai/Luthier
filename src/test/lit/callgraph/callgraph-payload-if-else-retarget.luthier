      %2 = freeze i128 poison
      %3 = call ptr addrspace(4) @llvm.amdgcn.kernarg.segment.ptr()
      %4 = ptrtoint ptr addrspace(4) %3 to i64
      %5 = call i32 @llvm.amdgcn.workgroup.id.x()
      %6 = freeze i32 poison
      %7 = call i32 @llvm.amdgcn.workitem.id.x()
