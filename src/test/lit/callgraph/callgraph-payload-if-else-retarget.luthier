      %68 = freeze i32 poison, !pcsections !120
      %69 = freeze i32 poison, !pcsections !120
      %70 = freeze i32 poison, !pcsections !120
      %71 = freeze i32 poison, !pcsections !120
      %72 = freeze i32 poison, !pcsections !120
      %73 = freeze i32 poison, !pcsections !120
      %74 = freeze i32 poison, !pcsections !120
      %75 = freeze i32 poison, !pcsections !120
