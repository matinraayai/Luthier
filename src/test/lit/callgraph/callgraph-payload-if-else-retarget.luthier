InstrumentationModule:  |
  ; ModuleID = 'callgraph-payload-if-else-retarget.instrumentation_module'
  source_filename = "callgraph-payload-if-else-retarget.instrumentation_module"
  target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn-amd-amdhsa"

  ; `luthier::readReg` / `luthier::writeReg` intrinsic decls. `7683` in the
  ; callers is `AMDGPU::SGPR0_SGPR1` -- the pair the target's
  ; `S_SWAPPC_B64 s[30:31], s[0:1]` reads as its indirect callee.
  declare i64 @"luthier::readReg.i64.i32"(i32) #1
  declare void @"luthier::writeReg.void.i32.i64"(i32, i64) #2

  ; The retarget hook.
  ;
  ; Reads the incoming callee pointer, compares against the two known
  ; "original" callees this instrumentor recognises (their addresses stand in
  ; here as literals 4096 / 8192 -- the analysis does not model runtime
  ; equality, so the specific values are only illustrative). For each match,
  ; writes back the corresponding instrumented version's entry-point address:
  ;   * 93945842149888 == `_Z8foo_instrvx0x0.entrypoint_addr`
  ;   * 93945842149896 == `_Z8goo_instrvx0x0.entrypoint_addr`
  ; so PrototypeCallGraph's addr -> Function* map (built from the target
  ; module's device-function entry-point attributes) resolves each writeReg
  ; value to the corresponding target-module Function.
  ;
  ; The if/else structure is what forces PrototypeCallGraph's payload-side
  ; resolver to keep *both* possible target functions -- neither dominates
  ; the other on any path, so `collectPayloadWrites` returns two independent
  ; PayloadWrite entries whose Values folds resolve to two different
  ; addresses, both attached to the same indirect call site.
  define internal void @luthier.payload.retarget() #0 {
  entry:
    %callee = call i64 @"luthier::readReg.i64.i32"(i32 7683)
    %is_foo = icmp eq i64 %callee, 4096
    br i1 %is_foo, label %write_foo, label %check_goo

  write_foo:
    call void @"luthier::writeReg.void.i32.i64"(i32 7683, i64 93945842149888)
    br label %end

  check_goo:
    %is_goo = icmp eq i64 %callee, 8192
    br i1 %is_goo, label %write_goo, label %end

  write_goo:
    call void @"luthier::writeReg.void.i32.i64"(i32 7683, i64 93945842149896)
    br label %end

  end:
    ret void
  }

  ; `naked` matches the shape `Prototype::createInjectedPayload` produces for
  ; a real injection: register discipline is entirely up to the writeReg
  ; intrinsics inside the payload.
  attributes #0 = { naked noinline "luthier.function.injected_payload" "target-cpu"="gfx908" "target-features"="+wavefrontsize64" }
  attributes #1 = { "luthier.intrinsic"="luthier::readReg" "target-cpu"="gfx908" }
  attributes #2 = { "luthier.intrinsic"="luthier::writeReg" "target-cpu"="gfx908" }
...
