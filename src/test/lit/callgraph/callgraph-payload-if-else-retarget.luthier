      %53 = freeze i32 poison, !pcsections !120
      %54 = freeze i32 poison, !pcsections !120
      %55 = freeze i32 poison, !pcsections !120
      %56 = freeze i32 poison, !pcsections !120
      %57 = freeze i32 poison, !pcsections !120
      %58 = freeze i32 poison, !pcsections !120
      %59 = bitcast i64 %26 to <2 x i32>, !pcsections !120
      %60 = extractelement <2 x i32> %59, i64 0, !pcsections !120
      %61 = extractelement <2 x i32> %59, i64 1, !pcsections !120
      %62 = freeze i32 poison, !pcsections !120
      %63 = freeze i32 poison, !pcsections !120
