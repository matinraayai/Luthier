  target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn-amd-amdhsa"

  ; Extern declaration whose Itanium name matches the target-module's device
  ; function `_Z3barvx0x0`. `@luthier.payload.handle` (below) uses
  ; `ptrtoint(@_Z3barvx0x0 to i64)` to form a Function-handle constant that
  ; the payload writes into the setpc's callee register.
  declare void @_Z3barvx0x0()

  ; `luthier::writeReg` intrinsic. The `luthier.intrinsic` fn-attribute is
  ; the discriminator PrototypeCallGraph's payload-side resolver keys on when
  ; scanning payload IR for register-write intrinsics. `7698` is
  ; `AMDGPU::SGPR30_SGPR31`, the pair the target's `S_SETPC_B64` reads.
  declare void @"luthier::writeReg.void.i32.i64"(i32, i64) #2

  ; Payload A -- writes the raw entry-point address of `_Z3barvx0x0` (as an
  ; i64) into sgpr[30:31]. `93944235341824` matches the
  ; `luthier.function.entrypoint.addr` attribute on `_Z3barvx0x0` above (and
  ; the trace-address metadata `!190`/`!193`), so PrototypeCallGraph's
  ; addr -> Function* map has an entry that resolves this value to
  ; `_Z3barvx0x0`.
  define internal void @luthier.payload.addr() #0 {
  entry:
    call void @"luthier::writeReg.void.i32.i64"(i32 7698, i64 93944235341824)
    ret void
  }

  ; Payload B -- writes the Function-handle constant `ptrtoint(@_Z3barvx0x0)`
  ; as an i64 into sgpr[30:31] instead of a raw address. PrototypeCallGraph's
  ; `extractFunctionHandle` unwraps the constant expression to reach the
  ; underlying `Function *` directly, without needing the addr -> Function*
  ; lookup that the address form takes.
  define internal void @luthier.payload.handle() #0 {
  entry:
    call void @"luthier::writeReg.void.i32.i64"(i32 7698, i64 ptrtoint (ptr @_Z3barvx0x0 to i64))
    ret void
  }

  ; `naked` marker matches the shape `Prototype::createInjectedPayload`
  ; produces for a real (non-test) injection: payload bodies are hooks whose
  ; register discipline is entirely up to the writeReg intrinsics.
  attributes #0 = { naked noinline "luthier.function.injected_payload" "target-cpu"="gfx908" "target-features"="+wavefrontsize64" }
  attributes #2 = { "luthier.intrinsic"="luthier::writeReg" "target-cpu"="gfx908" }
...
