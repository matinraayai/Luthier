      %34 = freeze i32 poison, !pcsections !109
      %35 = freeze i32 poison, !pcsections !109
      %36 = freeze i32 poison, !pcsections !109
      %37 = freeze i32 poison, !pcsections !109
      %38 = freeze i32 poison, !pcsections !109
      %39 = freeze i32 poison, !pcsections !109
      %40 = freeze i32 poison, !pcsections !109
      %41 = freeze i32 poison, !pcsections !109
