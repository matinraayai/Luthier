# Intent: verify that when an injected payload rewrites the branch-target
# register of a target-module `s_setpc_b64`, PrototypeCallGraph resolves the
# same callee whether the payload's writeReg carries a raw entry-point
# address or a Function-handle constant (`ptrtoint(@fn)`).
#
# The target module has two device-function call sites that both tail-call
# `_Z3barvx0x0` through an `s_setpc_b64 s[30:31]`:
#   * `_Z6kernelv` -- setpc's callee register is written by
#     `@luthier.payload.addr`, whose writeReg carries the raw entry-point
#     address literal `93944235341824`.
#   * `_Z3barvx0x0` -- setpc's callee register is written by
#     `@luthier.payload.handle`, whose writeReg carries
#     `ptrtoint(@_Z3barvx0x0 to i64)`.
# Both payloads are pre-installed via `TargetOpcode::PATCHPOINT` markers in
# the target MIR whose `pcsections` MDNodes carry the surrounding setpc's own
# trace-address, so `InjectedPayloadAndInstPointAnalysis` +
# `buildTraceAddrToMIMap` can link the setpc-lifted target-IR `CallInst`
# back to the payload the injection installed.
#
# NOTE -- this test's callgraph is dominated by IR-trace resolution. The
# setpc-lifted CallInst's callee is derivable from the surrounding
# `s_getpc_b64 + s_add_u32` sequence, so PrototypeCallGraph's fixed-point
# loop resolves the site before `resolveViaPayloads` gets called (the
# `Out.CallTargets.contains(CI)` short-circuit around
# PrototypeCallGraph.cpp:676). Swapping the payload's address literal for
# garbage leaves the printed callgraph unchanged. This test therefore
# asserts the invariant "payload injection at the setpc does not disturb an
# already-resolved callgraph edge"; the companion test
# `callgraph-payload-if-else-retarget.luthier` exercises the payload-driven
# resolution path with a genuinely opaque swappc.

# RUN: luthier-llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx908 \
# RUN:    '-passes=prototype-callgraph-printer' \
# RUN:    %s -o /dev/null | %tee_out FileCheck %s

# CHECK:      PrototypeCallGraph (fully_recovered=yes)
# CHECK:      Resolved call sites (2):
# CHECK-DAG:  _Z3barvx0x0 -> [_Z3barvx0x0]
# CHECK-DAG:  _Z6kernelv -> [_Z3barvx0x0]
# CHECK:      Incomplete call sites (0):

---
TargetModule:     |
  --- |
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    define weak protected amdgpu_kernel void @_Z6kernelv() #0 {
      %1 = call i32 @llvm.amdgcn.workgroup.id.x()
      %2 = freeze i32 poison
      %3 = call i32 @llvm.amdgcn.workitem.id.x()
      %4 = call i64 @llvm.amdgcn.s.getpc(), !pcsections !91
      %5 = bitcast i64 %4 to <2 x i32>
      %6 = extractelement <2 x i32> %5, i64 0
      %7 = zext i32 %6 to i64, !pcsections !97
      %8 = add i64 %7, 4294967036, !pcsections !97
      %9 = icmp uge i64 %8, 4294967296, !pcsections !97
      %10 = zext i1 %9 to i32, !pcsections !97
      %11 = trunc i64 %8 to i32, !pcsections !97
      %12 = extractelement <2 x i32> %5, i64 1
      %13 = zext i1 %9 to i64, !pcsections !104
      %14 = zext i32 %12 to i64, !pcsections !104
      %15 = add i64 %14, 4294967295, !pcsections !104
      %16 = add i64 %15, %13, !pcsections !104
      %17 = icmp uge i64 %16, 4294967296, !pcsections !104
      %18 = zext i1 %17 to i32, !pcsections !104
      %19 = trunc i64 %16 to i32, !pcsections !104
      %20 = insertelement <2 x i32> poison, i32 %19, i64 1
      %21 = insertelement <2 x i32> %20, i32 %11, i64 0
      %22 = bitcast <2 x i32> %21 to i64
      %23 = inttoptr i64 %22 to ptr, !pcsections !109
      %24 = freeze i32 poison, !pcsections !109
      %25 = freeze i32 poison, !pcsections !109
      %26 = freeze i32 poison, !pcsections !109
      %27 = freeze i32 poison, !pcsections !109
      %28 = freeze i32 poison, !pcsections !109
      %29 = freeze i32 poison, !pcsections !109
      %30 = freeze i32 poison, !pcsections !109
      %31 = freeze i32 poison, !pcsections !109
      %32 = freeze i32 poison, !pcsections !109
