      %45 = freeze i32 poison, !pcsections !109
      %46 = freeze i32 poison, !pcsections !109
      %47 = freeze i32 poison, !pcsections !109
      %48 = freeze i32 poison, !pcsections !109
      %49 = freeze i32 poison, !pcsections !109
      %50 = freeze i32 poison, !pcsections !109
      %51 = freeze i32 poison, !pcsections !109
      %52 = freeze i32 poison, !pcsections !109
      %53 = freeze i32 poison, !pcsections !109
      %54 = freeze i32 poison, !pcsections !109
      %55 = freeze i32 poison, !pcsections !109
      %56 = freeze i32 poison, !pcsections !109
      %57 = freeze i32 poison, !pcsections !109
      %58 = freeze i32 poison, !pcsections !109
      %59 = freeze i32 poison, !pcsections !109
      %60 = freeze i32 poison, !pcsections !109
      %61 = freeze i32 poison, !pcsections !109
      %62 = freeze i32 poison, !pcsections !109
      %63 = freeze i32 poison, !pcsections !109
      %64 = freeze i32 poison, !pcsections !109
      %65 = freeze i32 poison, !pcsections !109
      %66 = freeze i32 poison, !pcsections !109
      %67 = freeze i32 poison, !pcsections !109
      %68 = freeze i32 poison, !pcsections !109
      %69 = freeze i32 poison, !pcsections !109
      %70 = freeze i32 poison, !pcsections !109
      %71 = freeze i32 poison, !pcsections !109
      %72 = freeze i32 poison, !pcsections !109
      %73 = freeze i32 poison, !pcsections !109
      %74 = freeze i32 poison, !pcsections !109
      %75 = freeze i32 poison, !pcsections !109
      %76 = freeze i32 poison, !pcsections !109
      %77 = freeze i32 poison, !pcsections !109
      %78 = freeze i32 poison, !pcsections !109
      %79 = freeze i32 poison, !pcsections !109
      %80 = freeze i32 poison, !pcsections !109
      %81 = freeze i32 poison, !pcsections !109
      %82 = freeze i32 poison, !pcsections !109
      %83 = freeze i32 poison, !pcsections !109
      %84 = freeze i32 poison, !pcsections !109
      tail call void %23(i32 %1, i32 %2, i32 %24, i32 %25, i32 %26, i32 %27, i32 %28, i32 %29, i32 %30, i32 %31, i32 %32, i32 %33, i32 %34, i32 %35, i32 %36, i32 %37, i32 %38, i32 %39, i32 %40, i32 %41, i32 %42, i32 %43, i32 %44, i32 %45, i32 %46, i32 %47, i32 %48, i32 %49, i32 %50, i32 %51, i32 %11, i32 %19, i32 %52, i32 %53, i32 %54, i32 %55, i32 %56, i32 %57, i32 0, i32 0, i32 %58, i32 %59, i32 %60, i32 %61, i32 %62, i32 %63, i32 %64, i32 %65, i32 %66, i32 %67, i32 %68, i32 %69, i32 %70, i32 %71, i32 %72, i32 %73, i32 %74, i32 %75, i32 -1, i32 -1, i32 %76, i32 %77, i32 %18, i32 %3, i32 %78, i32 %79, i32 %80, i32 %81, i32 %82, i32 %83, i32 %84), !pcsections !109
      unreachable, !pcsections !109
    }
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef i32 @llvm.amdgcn.workgroup.id.x() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef range(i32 0, 1024) i32 @llvm.amdgcn.workitem.id.x() #1
    
    ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
    declare noundef i64 @llvm.amdgcn.s.getpc() #1
    
    define private void @_Z3barvx0x0(i32 %0, i32 %1, i32 %2, i32 %3, i32 %4, i32 %5, i32 %6, i32 %7, i32 %8, i32 %9, i32 %10, i32 %11, i32 %12, i32 %13, i32 %14, i32 %15, i32 %16, i32 %17, i32 %18, i32 %19, i32 %20, i32 %21, i32 %22, i32 %23, i32 %24, i32 %25, i32 %26, i32 %27, i32 %28, i32 %29, i32 %30, i32 %31, i32 %32, i32 %33, i32 %34, i32 %35, i32 %36, i32 %37, i32 %38, i32 %39, i32 %40, i32 %41, i32 %42, i32 %43, i32 %44, i32 %45, i32 %46, i32 %47, i32 %48, i32 %49, i32 %50, i32 %51, i32 %52, i32 %53, i32 %54, i32 %55, i32 %56, i32 %57, i32 %58, i32 %59, i32 %60, i32 %61, i32 %62, i32 %63, i32 %64, i32 %65, i32 %66, i32 %67, i32 %68, i32 %69, i32 %70) #2 {
      call void @llvm.amdgcn.s.waitcnt(i32 0), !pcsections !188
      %72 = insertelement <2 x i32> poison, i32 %31, i64 1
      %73 = insertelement <2 x i32> %72, i32 %30, i64 0
      %74 = bitcast <2 x i32> %73 to i64
      %75 = inttoptr i64 %74 to ptr, !pcsections !191
      tail call void %75(i32 %0, i32 %1, i32 %2, i32 %3, i32 %4, i32 %5, i32 %6, i32 %7, i32 %8, i32 %9, i32 %10, i32 %11, i32 %12, i32 %13, i32 %14, i32 %15, i32 %16, i32 %17, i32 %18, i32 %19, i32 %20, i32 %21, i32 %22, i32 %23, i32 %24, i32 %25, i32 %26, i32 %27, i32 %28, i32 %29, i32 %30, i32 %31, i32 %32, i32 %33, i32 %34, i32 %35, i32 %36, i32 %37, i32 %38, i32 %39, i32 %40, i32 %41, i32 %42, i32 %43, i32 %44, i32 %45, i32 %46, i32 %47, i32 %48, i32 %49, i32 %50, i32 %51, i32 %52, i32 %53, i32 %54, i32 %55, i32 %56, i32 %57, i32 %58, i32 %59, i32 %60, i32 %61, i32 %62, i32 %63, i32 %64, i32 %65, i32 %66, i32 %67, i32 %68, i32 %69, i32 %70), !pcsections !191
      unreachable, !pcsections !191
    }
    
    ; Function Attrs: nocallback nofree nounwind willreturn
    declare void @llvm.amdgcn.s.waitcnt(i32 immarg) #3
    
    ; Extern handles for the two injected payloads. `TargetOpcode::PATCHPOINT`
    ; markers below carry these as their "Target" global-address operand;
    ; `InjectedPayloadAndInstPointAnalysis` walks these markers and matches each
    ; extern's name back to its definition in the IModule.
    declare void @luthier.payload.addr()
    declare void @luthier.payload.handle()
    
    attributes #0 = { "amdgpu-dx10-clamp"="true" "amdgpu-ieee"="true" "amdgpu-implicitarg-num-bytes"="0" "amdgpu-lds-size"="0" "amdgpu-no-cluster-id-y" "amdgpu-no-cluster-id-z" "amdgpu-no-dispatch-id" "amdgpu-no-dispatch-ptr" "amdgpu-no-flat-scratch-init" "amdgpu-no-kernarg-segment-ptr" "amdgpu-no-queue-ptr" "amdgpu-no-workgroup-id-y" "amdgpu-no-workgroup-id-z" "amdgpu-no-workitem-id-y" "amdgpu-no-workitem-id-z" "amdgpu-num-sgpr"="40" "amdgpu-num-vgpr"="4" "amdgpu.kd.enable_exception_address_watch"="0" "amdgpu.kd.enable_exception_fp_denormal_source"="0" "amdgpu.kd.enable_exception_ieee_754_fp_division_by_zero"="0" "amdgpu.kd.enable_exception_ieee_754_fp_inexact"="0" "amdgpu.kd.enable_exception_ieee_754_fp_invalid_operation"="0" "amdgpu.kd.enable_exception_ieee_754_fp_overflow"="0" "amdgpu.kd.enable_exception_ieee_754_fp_underflow"="0" "amdgpu.kd.enable_exception_int_divide_by_zero"="0" "amdgpu.kd.enable_exception_memory"="0" "amdgpu.kd.enable_private_segment"="0" "amdgpu.kd.enable_sgpr_workgroup_info"="0" "amdgpu.kd.enable_trap_handler"="0" "amdgpu.kd.float_round_mode_16_64"="0" "amdgpu.kd.float_round_mode_32"="0" "amdgpu.kd.fp16_ovfl"="0" "amdgpu.kd.user_sgpr_count"="0" "denormal-fp-math"="ieee,ieee" "denormal-fp-math-f32"="ieee,ieee" "luthier.function.entrypoint.addr"="93944235337600" "luthier.function.initial_entrypoint" "luthier.function.initial_execution_point" }
    attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) }
    attributes #2 = { "amdgpu-num-sgpr"="40" "amdgpu-num-vgpr"="4" "luthier.function.entrypoint.addr"="93944235341824" }
