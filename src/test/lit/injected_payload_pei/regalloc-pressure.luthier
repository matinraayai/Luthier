InstrumentationModule:  |
  --- |
    ; ModuleID = 'regalloc-pressure.instrumentation_module'
    source_filename = "regalloc-pressure.instrumentation_module"
    target datalayout = "e-m:e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
    target triple = "amdgcn-amd-amdhsa"
    
    ; Function Attrs: naked noinline
    define void @luthier.payload.regalloc_pressure() #0 {
      %1 = call i32 asm sideeffect "luthier.placeholder.0", "=s"()
      %2 = call i32 asm sideeffect "luthier.placeholder.1", "=v"()
      %3 = call i32 asm sideeffect "luthier.placeholder.2", "=v"()
      %4 = call i32 asm sideeffect "luthier.placeholder.3", "=v"()
      %5 = call i32 asm sideeffect "luthier.placeholder.4", "=v"()
      %6 = call i32 asm sideeffect "luthier.placeholder.5", "=v"()
      %7 = call i32 asm sideeffect "luthier.placeholder.6", "=v"()
      %8 = call i32 asm sideeffect "luthier.placeholder.7", "=v"()
      %9 = call i32 asm sideeffect "luthier.placeholder.8", "=v"()
      %10 = call i32 asm sideeffect "luthier.placeholder.9", "=v"()
      ret void
    }
    
    attributes #0 = { naked noinline "luthier.function.injected_payload" "target-cpu"="gfx908" "target-features"="+wavefrontsize64" }
    
