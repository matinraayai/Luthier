//===----------------------------------------------------------------------===//
//
// Registry of Luthier
//
// This file lists ONLY Luthier-authored passes and analyses. Stock LLVM
// passes are already registered by \c llvm::PassBuilder; PrototypePassBuilder
// must not re-add them.
//
// Passes/analyses that require constructor arguments (a TargetMachine, an
// IntrinsicProcessorRegistry, etc.) cannot fit the plain macro form and
// are registered manually inside PrototypePassBuilder::registerLuthierPasses.
//
//===----------------------------------------------------------------------===//

// NOTE: NO INCLUDE GUARD DESIRED!

#ifndef MODULE_PASS
#define MODULE_PASS(NAME, CREATE_PASS)
#endif
MODULE_PASS("luthier-process-intrinsics-at-ir-level",
            ProcessIntrinsicsAtIRLevelPass())
#undef MODULE_PASS

#ifndef FUNCTION_ANALYSIS
#define FUNCTION_ANALYSIS(NAME, CREATE_PASS)
#endif
FUNCTION_ANALYSIS("luthier-injected-payload-side-effects",
                  InjectedPayloadSideEffectsAnalysis())
#undef FUNCTION_ANALYSIS

#ifndef MACHINE_FUNCTION_ANALYSIS
#define MACHINE_FUNCTION_ANALYSIS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_ANALYSIS("luthier-instruction-traces",
                          InstructionTracesAnalysis())
MACHINE_FUNCTION_ANALYSIS("luthier-trace-function-translation",
                          TraceFunctionTranslationAnalysis())
#undef MACHINE_FUNCTION_ANALYSIS

#ifndef MACHINE_FUNCTION_PASS
#define MACHINE_FUNCTION_PASS(NAME, CREATE_PASS)
#endif
MACHINE_FUNCTION_PASS("luthier-injected-payload-pei", InjectedPayloadPEIPass())
// Runs pre-WWM-regalloc on injected-payload MFs; despite operating in service
// of the prototype's SVA it is a plain MachineFunction pass, so it must not be
// listed as a PROTOTYPE_PASS.
MACHINE_FUNCTION_PASS("luthier-sva-phys-vgpr-pin", SVAPhysVGPRPinPass())
#undef MACHINE_FUNCTION_PASS

// Prototype-level passes and analyses run against \c luthier::Prototype.
// These macros are exclusive to the Luthier pipeline; they have no LLVM
// analogue.

#ifndef PROTOTYPE_PASS
#define PROTOTYPE_PASS(NAME, CREATE_PASS)
#endif
PROTOTYPE_PASS("luthier-code-discovery", CodeDiscoveryPass())
PROTOTYPE_PASS("luthier-intrinsic-mir-lowering", IntrinsicMIRLoweringPass())
PROTOTYPE_PASS("luthier-injected-payload-preserve-live-regs",
               InjectedPayloadPreserveLiveRegsPass())
PROTOTYPE_PASS("luthier-target-module-patcher", TargetModulePatcherPass())
PROTOTYPE_PASS("luthier-print-ip-pred-cfg", IPPredCFGPrinter(llvm::outs()))
#undef PROTOTYPE_PASS

#ifndef PROTOTYPE_ANALYSIS
#define PROTOTYPE_ANALYSIS(NAME, CREATE_PASS)
#endif
PROTOTYPE_ANALYSIS("luthier-ip-pred-cfg", IPPredCFGAnalysis())
PROTOTYPE_ANALYSIS("luthier-ip-predicated-liveness",
                   IPPredicatedLivenessAnalysis())
PROTOTYPE_ANALYSIS("luthier-injected-payload-and-inst-point",
                   InjectedPayloadAndInstPointAnalysis())
PROTOTYPE_ANALYSIS("luthier-sv-storage-and-load-locations",
                   SVStorageAndLoadLocationsAnalysis())
PROTOTYPE_ANALYSIS("luthier-state-value-array-specs",
                   StateValueArraySpecsAnalysis())
PROTOTYPE_ANALYSIS("luthier-prototype-call-graph", PrototypeCallGraphAnalysis())
#undef PROTOTYPE_ANALYSIS
