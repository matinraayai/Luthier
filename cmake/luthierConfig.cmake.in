include_guard(DIRECTORY)

# Add file path
get_filename_component(_dir "${CMAKE_CURRENT_LIST_FILE}" PATH)

list(INSERT CMAKE_MODULE_PATH 0 "${_dir}")

set(LUTHIER_COMPILED_WITH_SPIRV_SUPPORT @LUTHIER_ENABLE_SPIRV@)

# Find dependencies
include(CMakeFindDependencyMacro)
find_dependency(hip CONFIG)
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)
find_dependency(rocprofiler-sdk CONFIG)
find_dependency(hsa-runtime64 CONFIG)
find_dependency(LLVM CONFIG)
find_dependency(Clang CONFIG)

if (LUTHIER_COMPILED_WITH_SPIRV_SUPPORT)
  find_dependency(LLVMSPIRVTranslator)
  find_dependency(AMDDeviceLibs)
endif ()

include("${_dir}/luthierTargets.cmake")

# Import the plugin macros
include("${_dir}/LuthierAddCompilerPlugin.cmake")
include("${_dir}/LuthierAddClangPlugin.cmake")
include("${_dir}/LuthierCreateOffloadBundle.cmake")
